# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
#
# ---------------------------------------------------------------------------
# LinkedIn session
# ---------------------------------------------------------------------------
# Both come from the cookies of a logged-in linkedin.com browser session.
# Use a BURNER ACCOUNT. Scraping can get an account restricted.
#
# DevTools -> Application -> Cookies -> https://www.linkedin.com
#
# `li_at` IS the session. Anyone holding it is logged in as you.
# It looks like a long opaque base64-ish blob.
LINKEDIN_LI_AT=

# `JSESSIONID` value is literally  "ajax:1234567890123456789"  — INCLUDING the
# double quotes. Paste it exactly as DevTools shows it; the code strips the
# quotes itself to derive the `csrf-token` request header (double-submit cookie).
LINKEDIN_JSESSIONID=

# ---------------------------------------------------------------------------
# Our own API
# ---------------------------------------------------------------------------
# Clients must send this as the `x-api-key` header. Without it we would be
# running a free public scraping proxy for the whole internet.
# Generate one:  openssl rand -hex 32
API_KEY=

PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Cache TTL for a fetched profile, in seconds. Caching is the single most
# effective way to keep upstream request volume (and thus ban risk) low.
CACHE_TTL_SECONDS=3600

# Pacing between PROFILE fetches (not between the section requests of one
# profile — those burst, the way a real page load does). This protects the
# burner account far more than it protects this server.
UPSTREAM_MIN_INTERVAL_MS=40000
UPSTREAM_JITTER_MS=15000

# ---------------------------------------------------------------------------
# Egress
# ---------------------------------------------------------------------------
# There is no proxy configuration. Requests leave over whatever egress the host
# has, so run this behind a VPN if the origin IP matters to you — that is an
# operator/network concern, deliberately not an application one.
