{
  "name": "reverse-linkedin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hosted API that turns a LinkedIn profile URL into structured JSON, via LinkedIn's private Voyager API.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.2.2",
    "fastify": "^5.2.1",
    "ipaddr.js": "^2.2.0",
    "undici": "^7.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
